{
  "name": "zidane-books",
  "version": "0.1.0",
  "private": true,
  "description": "Zoho Books-style accounting and inventory web app for Zidane Wholesale Solutions",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/books.test.js server/assistant.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "imapflow": "^2.5.2",
    "mailparser": "^3.9.40",
    "nodemailer": "^10.1.2",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.4.4"
  }
}
